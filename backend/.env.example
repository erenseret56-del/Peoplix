# ===================================
# PEOPLIX BACKEND ENVIRONMENT
# ===================================

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true

# ===================================
# DATABASE (MongoDB Atlas)
# ===================================
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/peoplix?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/peoplix?retryWrites=true&w=majority
DB_NAME=peoplix

# ===================================
# FREE CLOUD CACHE (UPSTASH REDIS)
# ===================================
# Free tier: https://upstash.com/
# Set these if you want to use a free hosted Redis cache instead of local memory cache.
CACHE_PROVIDER=upstash
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ===================================
# JWT & SECURITY
# ===================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# ===================================
# RETELL AI
# ===================================
RETELL_API_KEY=your-retell-api-key-here
RETELL_AGENT_ID=your-retell-agent-id-here
RETELL_LLM_ID=your-retell-llm-id-here
RETELL_WEBHOOK_SECRET=your-webhook-secret-here
RETELL_TWILIO_TERMINATION_URI=sip:your-twilio-termination-uri

# ===================================
# TWILIO PHONE NUMBERS
# ===================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_COUNTRY_CODE=US

# ===================================
# ADMIN CREDENTIALS
# ===================================
ADMIN_EMAIL=admin@peoplix.com
ADMIN_PASSWORD=change-this-secure-password

# ===================================
# CORS & FRONTEND
# ===================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===================================
# RATE LIMITING
# ===================================
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

# ===================================
# FILE UPLOADS (Future)
# ===================================
# MAX_FILE_SIZE=10485760
# UPLOAD_DIR=./uploads

# ===================================
# EMAIL (Future)
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@peoplix.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@peoplix.com
