{
  "name": "peoplix-backend",
  "version": "1.0.0",
  "description": "PEOPLIX Multi-tenant SaaS Backend - Production-ready Node.js/TypeScript API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "db:seed": "node --loader tsx src/infrastructure/database/seed.ts",
    "db:phone-assignments": "node --loader tsx src/infrastructure/database/phone-assignment-migration.ts"
  },
  "keywords": [
    "saas",
    "multi-tenant",
    "ai",
    "voice-agent",
    "retell",
    "fastify",
    "postgresql"
  ],
  "author": "PEOPLIX Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.10.0",
    "officeparser": "6.0.7",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "twilio": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "pdfjs-dist": "6.2.108"
  }
}
