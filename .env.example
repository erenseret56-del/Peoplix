# Frontend-only public configuration. Never put backend secrets here.
VITE_BASE_URL=https://api.example.com
# Only required by the legacy WebSocket demo path, if enabled.
VITE_WS_URL=wss://api.example.com
# EmailJS public identifiers are browser-safe; keep private provider secrets out.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=